PORT=4000
MONGO_URI=mongodb://localhost:27017/uptime
JWT_SECRET=replace-with-a-long-random-string
LOG_LEVEL=info
AUTH_RATE_LIMIT_MAX=20
# test database, must end with -test (tests refuse to run otherwise)
MONGO_URI_TEST=mongodb://localhost:27017/uptime-test
FAILURE_THRESHOLD=2
EMAIL_DAILY_CAP=20
# SMTP for the worker. Local development uses Mailpit on localhost:1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Uptime Monitor <alerts@uptime.local>
